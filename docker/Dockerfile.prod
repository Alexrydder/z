# Production image for go.gablvm.org: the dev image (Ruby, gems, Node) plus
# the application source and precompiled assets.
FROM localhost/z-app:dev
USER root
# The dev image copies the tree it was built from; drop it so removed files
# do not linger under the fresh copy.
RUN rm -rf /app/lib /app/app /app/config /app/db /app/public /app/cypress
COPY --chown=vscode:vscode . /app
# log and tmp are left out of the build context; Rails writes to both.
RUN mkdir -p /app/log /app/tmp && chown vscode:vscode /app/log /app/tmp
USER vscode
WORKDIR /app
# config/secrets.yml reads RAILS_SECRET; the real one reaches the container at
# run time from /srv/z/.env, which never goes into the image.
RUN bundle install --quiet && npm ci --no-audit --no-fund \
 && RAILS_ENV=production SECRET_KEY_BASE=build-only RAILS_SECRET=build-only DB_HOST=127.0.0.1 DB_PORT=3307 DB_DATABASE=z DB_USERNAME=z DB_PASSWORD=x OMNIAUTH_PROVIDER=developer USER_LOOKUP_SKELETON=1 \
    bundle exec rails assets:precompile
