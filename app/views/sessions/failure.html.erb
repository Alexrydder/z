<div class="error-page">
  <h1 class="error-page__heading">Sign-in did not complete</h1>
  <div class="error-page__message">
    <p>The sign-in check failed with the reason <code><%= @reason %></code>.</p>
    <p><a href="/shortener/signin">Try again</a>, or write to <a href="mailto:help@gablvm.org">help@gablvm.org</a> and quote the reason above.</p>
  </div>
</div>
